{
  "name": "@pushgiant/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node dist/migrations/run.js",
    "migrate:dry": "node dist/migrations/dry-run.js",
    "seed:demo": "node dist/migrations/seed-demo.js"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@pushgiant/shared": "0.1.0",
    "bullmq": "5.81.2",
    "fastify": "5.10.0",
    "ioredis": "5.4.1",
    "pg": "8.12.0",
    "web-push": "3.6.7",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/pg": "8.11.6",
    "@types/web-push": "3.6.4",
    "tsx": "4.23.1",
    "typescript": "5.4.5"
  }
}
